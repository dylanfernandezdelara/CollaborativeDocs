# Public Convex deployment URL (safe to commit — already embedded in the client bundle).
# Ensures Preview and Production builds both point at the shared backend.
NEXT_PUBLIC_CONVEX_URL=https://different-anaconda-22.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://different-anaconda-22.convex.site

# After CONVEX_DEPLOY_KEY is set on Vercel Production (so `npm run build` runs
# `convex deploy`), enable these in Vercel env and redeploy:
# NEXT_PUBLIC_DOCS_OWNER_SCOPING=1
# NEXT_PUBLIC_HUMAN_COLLABORATORS=1

