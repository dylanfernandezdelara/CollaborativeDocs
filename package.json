{
  "name": "collaborative-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:web:ready": "bash -c 'until curl -sf http://127.0.0.1:3210 >/dev/null; do sleep 1; done; exec npm run dev:web'",
    "dev:convex": "CONVEX_AGENT_MODE=anonymous npx convex dev",
    "convex:once": "CONVEX_AGENT_MODE=anonymous npx convex dev --once",
    "setup:agent": "npm ci && npm run convex:once",
    "build": "node scripts/build.mjs",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@base-ui/react": "^1.6.0",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/prosemirror-sync": "^0.2.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/html": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.7",
    "mcp-handler": "^2.1.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
